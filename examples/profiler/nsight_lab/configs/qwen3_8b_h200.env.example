# Copy values into your shell or source a machine-local file. Do not commit
# private model paths, credentials, or machine-specific compatibility libraries.
export MODEL_PATH=/path/to/Qwen3-8B-BF16
export VENV_PATH=/path/to/venv
export SGLANG_REPO_ROOT=/path/to/sglang
export NSYS=/path/to/nsys
export NCU=/path/to/ncu
export NCU_SECTIONS="SpeedOfLight MemoryWorkloadAnalysis SchedulerStats WarpStateStats SourceCounters Occupancy InstructionStats"

# CUDA_VISIBLE_DEVICES is interpreted by the process that launches the lab.
export CUDA_VISIBLE_DEVICES=0
export DTYPE=bfloat16
export MEM_FRACTION_STATIC=0.60
export CONTEXT_LENGTH=4096

# Core A/B and bounded profiler captures.
export BATCH_SIZE=1
export INPUT_LEN=256
export OUTPUT_LEN=128
export PROFILE_START_STEP=32
export PROFILE_STEPS=16
export REPEATS=5
export WARMUP_RUNS=1

# Offline shape sweep. Values are whitespace-separated lists.
export BATCH_SIZES="1 4 16"
export INPUT_LENS="128 512 2048"
export OUTPUT_LENS="32 128"

# Online serving sweep.
export SERVER_PORT=30000
export CONCURRENCIES="1 8 32"
export NUM_PROMPTS=64
export RANDOM_INPUT_LEN=256
export RANDOM_OUTPUT_LEN=64
export SERVING_DATASET=random-ids
export TOKENIZE_PROMPT=1
export SLO_P99_TTFT_MS=1000
export SLO_P99_TPOT_MS=100

# Set to 0 only when Nsight Compute is unavailable or unsupported.
export RUN_NCU=1
